PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/unihostel?retryWrites=true&w=majority
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG_USE_CRYPTO_RANDOMUUID
ADMIN_USERNAME=admin_username
ADMIN_PASSWORD=strong_admin_password
ADMIN_EMAIL=admin@example.com
NODE_ENV=production
FRONTEND_URL=https://your-frontend-url.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend-url.vercel.app,http://localhost:5173,http://localhost:3000
AUTH_COOKIE_SAME_SITE=none
AUTH_COOKIE_DOMAIN=
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
VERIFICATION_TOKEN_EXPIRY_HOURS=24
UNVERIFIED_USER_RETENTION_DAYS=30

# Account Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Manager Creation (for create-manager.js script)
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=ChangeThisSecurePassword123!
MANAGER_NAME=Manager Name
MANAGER_SECURITY_QUESTION=What is your email address?
MANAGER_SECURITY_ANSWER=

# Payment Configuration
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
ADMIN_COMMISSION_PERCENT=3

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_RATE_LIMIT_MAX=3
VERIFICATION_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
VERIFICATION_EMAIL_RATE_LIMIT_MAX=3

# Intrusion Detection System (IDS)
SECURITY_ENABLED=false
SECURITY_AUTO_BLOCK=false
SECURITY_ALERT_EMAIL=your-email@example.com
VISITOR_TRACKING_ENABLED=false

# Optional: Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Discord Alerts
DISCORD_WEBHOOK_URL=

# Penetration Testing (Optional - for security testing only)
TEST_EMAIL_PREFIX=pentest
TEST_PASSWORD=TestSecure123!
