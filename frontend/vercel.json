{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "env": {
    "VITE_API_URL": "https://unihostel.onrender.com",
    "VITE_PAYSTACK_PUBLIC_KEY": "pk_test_your_public_key_here"
  },
  "rewrites": [
    {
      "source": "/((?!assets/|icon\\.svg|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
